// Career Application Assistant — core data layer
// Maps 1:1 to the schema defined in the implementation plan, Section 4.
// pgvector columns use Unsupported("vector(1536)") since Prisma has no
// native vector type; the ANN index itself is created in the raw SQL
// migration (Prisma Migrate can version the column but not ivfflat/hnsw
// index syntax).

// Default ambient output (node_modules/.prisma/client). A custom `output`
// path was tried earlier as a workaround for prisma/prisma#7234/#25947,
// but the real cause turned out to be a regression in Prisma 6.14+
// (prisma/prisma#27925, fixed here by pinning to 6.13.0 in
// packages/db/package.json) -- not the output location. Keeping the
// default matters because Next.js's own Prisma-aware output-file-tracing
// only auto-bundles the native query engine binary for functions when the
// client lives at the default location; a custom path made every API
// route that touches Prisma throw "could not locate the Query Engine" in
// production even though the build succeeded.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pgcrypto]
}

// ---------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  candidateProfile   CandidateProfile?
  resumes            Resume[]
  jobDescriptions    JobDescription[]
  coverLetters       CoverLetter[]
  outreachMessages   OutreachMessage[]
  starStories        StarStory[]
  interviewPrepPacks InterviewPrepPack[]
  conversations      Conversation[]

  @@map("users")
}

model CandidateProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  currentTitle    String?  @map("current_title")
  yearsExperience Int?     @map("years_experience")
  industry        String?
  careerLevel     String?  @map("career_level") // entry | mid | senior | executive
  targetTitles    String[] @map("target_titles")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

// ---------------------------------------------------------------------
// Resumes
// ---------------------------------------------------------------------

model Resume {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  sourceType String                @map("source_type") // 'uploaded' | 'built_from_scratch'
  rawFileUrl String?               @map("raw_file_url")
  parsedText String?               @map("parsed_text")
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ResumeVersion[]

  @@index([userId])
  @@map("resumes")
}

model ResumeVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId          String   @map("resume_id") @db.Uuid
  jobDescriptionId  String?  @map("job_description_id") @db.Uuid
  versionLabel      String   @map("version_label") // e.g. "ATS-optimized v2"
  contentJson       Json     @map("content_json") // structured: summary, skills[], experience[], education[]
  atsChecklist      Json?    @map("ats_checklist") // Section 1 Step 10 checklist state
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  resume         Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription JobDescription?   @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  matches        ResumeJdMatch[]
  coverLetters   CoverLetter[]
  conversations  Conversation[]

  @@index([resumeId])
  @@index([jobDescriptionId])
  @@map("resume_versions")
}

// ---------------------------------------------------------------------
// Job descriptions & matching
// ---------------------------------------------------------------------

// Where a JobDescription row came from. MANUAL covers the original
// "paste a JD" flow from Sections 1-6; the other three are populated by
// the one-click-apply job search (lib/jobs/apify-client.ts).
enum JobSource {
  MANUAL
  LINKEDIN
  INDEED
  HIRINGCAFE
}

// The 6 pipeline stages from the one-click-apply workflow. Every scraped
// job starts at AVAILABLE_TO_APPLY; MANUAL (chat-pasted) job descriptions
// also default there but the status board is mostly meaningless for them
// since they don't go through the search/apply flow.
enum JobStatus {
  AVAILABLE_TO_APPLY
  TO_BE_APPLIED
  APPLIED
  IN_PROGRESS
  REJECTED
  NO_ANSWER
}

model JobDescription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  companyName        String?   @map("company_name")
  roleTitle          String?   @map("role_title")
  rawText            String    @map("raw_text")
  extractedKeywords  Json?     @map("extracted_keywords") // {required: [], preferred: [], tools: []}
  embedding          Unsupported("vector(1536)")?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // --- one-click-apply job search fields ---
  source          JobSource  @default(MANUAL)
  externalId      String?    @map("external_id") // job ID from the source platform, for dedup alongside externalUrl
  externalUrl     String?    @unique @map("external_url")
  location        String?
  workplaceType   String?    @map("workplace_type") // remote | hybrid | onsite, when the source provides it
  salaryText      String?    @map("salary_text") // raw string -- formats vary too much across sources to normalize reliably
  experienceLevel String?    @map("experience_level") // best-effort tag; see lib/jobs/normalize.ts
  postedAt        DateTime?  @map("posted_at") @db.Timestamptz(6)
  scrapedAt       DateTime?  @map("scraped_at") @db.Timestamptz(6)
  status          JobStatus  @default(AVAILABLE_TO_APPLY)
  notes           String?
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersions     ResumeVersion[]
  matches            ResumeJdMatch[]
  coverLetters       CoverLetter[]
  outreachMessages   OutreachMessage[]
  interviewPrepPacks InterviewPrepPack[]
  conversations      Conversation[]

  @@index([userId])
  @@index([userId, status])
  @@index([source])
  @@map("job_descriptions")
}

model ResumeJdMatch {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeVersionId   String   @map("resume_version_id") @db.Uuid
  jobDescriptionId  String   @map("job_description_id") @db.Uuid
  matchScore        Decimal? @map("match_score") @db.Decimal(5, 2)
  missingKeywords   Json?    @map("missing_keywords")
  matchedKeywords   Json?    @map("matched_keywords")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  resumeVersion  ResumeVersion  @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@index([resumeVersionId])
  @@index([jobDescriptionId])
  @@map("resume_jd_matches")
}

// ---------------------------------------------------------------------
// Generated artifacts
// ---------------------------------------------------------------------

model CoverLetter {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  jobDescriptionId  String   @map("job_description_id") @db.Uuid
  resumeVersionId   String?  @map("resume_version_id") @db.Uuid
  content           String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription JobDescription  @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  resumeVersion  ResumeVersion?  @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("cover_letters")
}

model OutreachMessage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  jobDescriptionId String   @map("job_description_id") @db.Uuid
  messageType      String   @map("message_type") // 'recruiter_email' | 'linkedin_message' | 'referral_request' | 'follow_up' -- Section 6.9 categories
  content          String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("outreach_messages")
}

model StarStory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  title           String
  competencyTags  String[] @map("competency_tags") // e.g. {leadership, conflict, failure}
  situation       String
  task            String
  action          String
  result          String
  targetRole      String?  @map("target_role")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewPrepPacks InterviewPrepPack[]  @relation("PrepPackStories")

  @@index([userId])
  @@map("star_stories")
}

model InterviewPrepPack {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  jobDescriptionId      String?  @map("job_description_id") @db.Uuid
  commonAnswers         Json?    @map("common_answers") // career-question responses (Section 4 Step 6)
  interviewerQuestions  Json?    @map("interviewer_questions")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  starStories    StarStory[]     @relation("PrepPackStories")

  @@index([userId])
  @@map("interview_prep_packs")
}

// ---------------------------------------------------------------------
// Conversations, messages, observability
// ---------------------------------------------------------------------

model Conversation {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  title                   String?
  activeResumeVersionId   String?  @map("active_resume_version_id") @db.Uuid
  activeJobDescriptionId  String?  @map("active_job_description_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeResumeVersion   ResumeVersion?  @relation(fields: [activeResumeVersionId], references: [id], onDelete: SetNull)
  activeJobDescription  JobDescription? @relation(fields: [activeJobDescriptionId], references: [id], onDelete: SetNull)
  messages              Message[]
  taskRuns              TaskRun[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  role            String   // 'user' | 'assistant'
  content         String
  mode            String?  // router classification, e.g. 'resume_optimize', 'section_6_11'
  artifactType    String?  @map("artifact_type") // 'resume_version' | 'cover_letter' | 'star_story' | null
  artifactId      String?  @map("artifact_id") @db.Uuid // FK resolved at app layer (polymorphic)
  guardrailFlags  Json?    @map("guardrail_flags") // unsupported claims caught/stripped, for audit
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  taskRuns     TaskRun[]

  @@index([conversationId])
  @@map("messages")
}

model TaskRun {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  messageId         String   @map("message_id") @db.Uuid
  routerMode        String?  @map("router_mode")
  routerConfidence  Decimal? @map("router_confidence") @db.Decimal(4, 3)
  missingInfo       String[] @map("missing_info")
  latencyMs         Int?     @map("latency_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@map("task_runs")
}
